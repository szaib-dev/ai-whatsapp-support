{
  "name": "codetic-ai",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck -w apps/web",
    "build": "npm run build -w apps/web && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "start:api": "node scripts/start-api.mjs",
    "build:api": "tsc -p tsconfig.build.json",
    "start:web": "npm run start -w apps/web",
    "check:production": "node scripts/production-check.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@supabase/supabase-js": "2.119.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.0.0",
    "fastify": "5.12.8",
    "google-auth-library": "^10.9.1",
    "luxon": "^3.7.2",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "type": "module"
}
