DATABASE_URL=
# Optional PEM CA file for verified database TLS (relative to repository root).
DATABASE_SSL_CA_FILE=
# Server-only: base64-encoded 32-byte random encryption key. Back it up privately.
SESSION_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
WEB_ORIGIN=http://localhost:3000
PORT=3101
HOST=127.0.0.1
# apps/web/.env.local: public values only
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_API_URL=http://localhost:3101
# Google Calendar (server-only; see CALENDAR_SETUP.md)
# Public HTTPS API origin, for example https://api.yourdomain.com
PUBLIC_API_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: permits explicitly configured localhost OAuth redirects.
CALENDAR_ALLOW_LOCAL_OAUTH=false

# Native browser Web Push (optional; notification centre works without it).
# Generate once: node scripts/setup-push.mjs .env
# Use .env.production as the argument for deployment; never commit private keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://codetic.netawaz.pk
