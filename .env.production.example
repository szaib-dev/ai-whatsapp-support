# Copy to .env.production on the VPS; chmod 600. Never commit the populated file.
# Direct PostgreSQL or Supabase SESSION pooler (5432), never transaction pooler (6543).
# URL-encode password characters. No sslmode/sslcert URL overrides.
DATABASE_URL=postgresql://SET_USER:SET_PASSWORD@SET_HOST:5432/postgres
DATABASE_SSL_CA_FILE=/run/config/db-ca.pem
SUPABASE_URL=https://SET_PROJECT.supabase.co
SUPABASE_ANON_KEY=SET_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# PRESERVE the EXISTING key; replacing it breaks saved WhatsApp and Calendar credentials.
SESSION_ENCRYPTION_KEY=SET_EXISTING_32_BYTE_BASE64_KEY
DEEPSEEK_API_KEY=SET_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GOOGLE_CLIENT_ID=SET_EXISTING_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=SET_EXISTING_WEB_CLIENT_SECRET
WEB_ORIGIN=https://codetic.netawaz.pk
PUBLIC_API_URL=https://api.netawaz.pk
CALENDAR_ALLOW_LOCAL_OAUTH=false
# Optional verified Supabase UUID(s) allowed to bootstrap a first business.
# Existing organization members already pass the admin session check.
ADMIN_USER_IDS=
OPERATOR_LEGAL_NAME="Shahzaib Mirza (operating under the brand Codetic)"
OPERATOR_COUNTRY=Pakistan
SUPPORT_EMAIL=szaib.dev@gmail.com
PRIVACY_EMAIL=szaib.dev@gmail.com
# Set the ACTUAL Supabase and offsite-backup retention/deletion schedule.
BACKUP_RETENTION_DESCRIPTION="SET_APPROVED_BACKUP_RETENTION_DESCRIPTION"
# Release gates: set true only after the review, never merely to bypass validation.
LEGAL_DISCLOSURES_APPROVED=false
AI_PROVIDER_DATA_TERMS_CONFIRMED=false
RELEASE_TAG=local

# Native browser Web Push. Generate once in the secret deployment environment:
# node scripts/setup-push.mjs .env.production
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://codetic.netawaz.pk

# Optional provider pricing, USD per million tokens, used only for cost estimates.
# Leave empty if current contractual pricing has not been configured.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
